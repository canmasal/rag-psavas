# Veritabanı (varsayılan: SQLite dosyası). Üretimde PostgreSQL için README'ye bakın.
DATABASE_URL="file:./dev.db"

# Oturum güvenliği için en az 32 karakterlik rastgele bir anahtar
AUTH_SECRET="degistirin-en-az-32-karakterlik-rastgele-bir-anahtar"

# Sitenin tam adresi (ödeme geri dönüşleri için gereklidir)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# İlk yönetici hesabı (seed sırasında oluşturulur)
ADMIN_EMAIL="admin@ragipsavassanat.com"
ADMIN_PASSWORD="Admin123!"

# iyzico ödeme entegrasyonu. Boş bırakılırsa site TEST MODUNDA çalışır.
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"

# E-posta gönderimi (şifre sıfırlama, bildirimler). Boş bırakılırsa e-postalar sunucu günlüğüne yazılır.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Ragıp Savaş Sanat Akademisi <istanbul@ragipsavassanat.com>"

# Yüklenen görsellerin saklanacağı klasör (varsayılan: proje içindeki uploads/)
# UPLOAD_DIR="/var/www/ragipsavas/uploads"
